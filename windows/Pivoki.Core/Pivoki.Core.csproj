<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><RootNamespace>Pivoki.Core</RootNamespace><RestorePackagesWithLockFile>true</RestorePackagesWithLockFile></PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageReference Include="PDFsharp" Version="6.2.4" />
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
    <PackageReference Include="Magick.NET-Q8-AnyCPU" Version="15.0.0" />
    <PackageReference Include="ResvgSharp" Version="1.0.3" />
    <PackageReference Include="ZXing.Net" Version="0.16.11" />
    <PackageReference Include="SharpCompress" Version="0.50.5" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
  </ItemGroup>
  <ItemGroup><EmbeddedResource Include="../Resources/FeatureCatalog.json" LogicalName="Pivoki.FeatureCatalog.json" /></ItemGroup>
  <ItemGroup><EmbeddedResource Include="../Resources/Turkish.json" LogicalName="Pivoki.Turkish.json" /></ItemGroup>
  <ItemGroup><EmbeddedResource Include="../Resources/LatinWords.json" LogicalName="Pivoki.LatinWords.json" /></ItemGroup>
  <ItemGroup><InternalsVisibleTo Include="Pivoki.Verify" /></ItemGroup>
  <ItemGroup Condition="'$(PivokiUpdateKey)' != ''"><AssemblyMetadata Include="PivokiUpdateKey" Value="$(PivokiUpdateKey)" /></ItemGroup>
</Project>
